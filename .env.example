# Copy this file to .env and fill in real values.
# Never commit .env.

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Comma-separated Discord guild (server) IDs for fast command sync during dev.
# Leave blank to sync globally (takes up to 1 hour to propagate).
DISCORD_GUILD_IDS=

# Yonder API key — starts with yd_live_
YONDER_API_KEY=yd_live_replace_me

# Yonder base URL (leave default unless testing)
YONDER_BASE_URL=https://yonderdrop.com/v1

# Stripe — use sk_test_... keys while developing. Switch to sk_live_... in prod.
STRIPE_SECRET_KEY=sk_test_replace_me

# Where Stripe sends customers after a successful or cancelled payment.
# Any valid https URL works; defaults are fine for test mode.
STRIPE_SUCCESS_URL=https://discord.com
STRIPE_CANCEL_URL=https://discord.com

# Markup on top of Yonder's price, as a percent (e.g. "15" for +15%).
# Set to 0 to charge customers exactly what the order costs you.
STRIPE_MARKUP_PERCENT=0

# Your own Discord user id — gets DMs when an order needs human attention.
# Right-click your username in Discord (with Developer Mode on) → Copy User ID.
OWNER_DISCORD_ID=

# Where to put the SQLite database file. Default is slashdat.db in the project folder.
DATABASE_PATH=slashdat.db
